# This is YOUR starter application's database, never Socketly's service database.
DATABASE_URL=postgresql://starter:starter-local-only@localhost:55432/socketly_starter
BETTER_AUTH_URL=http://localhost:3000
# npm run setup generates a random secret in the ignored .env.local file.
BETTER_AUTH_SECRET=

# Create a Socketly app, enable Inbox in its Settings, and allow localhost:3000.
NEXT_PUBLIC_SOCKETLY_KEY=
SOCKETLY_SECRET=
NEXT_PUBLIC_SOCKETLY_URL=https://api.socketly.co
SOCKETLY_URL=https://api.socketly.co
